{
  "name": "agentrouter-claim",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply agentrouter-claim --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "tailwind-merge": "^3.6.0"
  }
}
